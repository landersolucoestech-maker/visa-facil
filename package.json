{
  "name": "visa-facil",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @visa-facil/web run dev",
    "build": "npm --workspace @visa-facil/web run build",
    "typecheck": "npm --workspace @visa-facil/web run typecheck",
    "validate": "node scripts/validate-public-site.mjs && node scripts/validate-site-cms-style-ownership.mjs",
    "lint": "node scripts/lint-source.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run validate && npm run lint && npm run test && npm run audit && npm run typecheck && npm run build"
  }
}
