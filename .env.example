# Dados demonstrativos do protótipo.
# Atualmente ficam ativos por padrão, inclusive no build do GitHub Pages.
# Defina explicitamente como false quando quiser desligar todos os mocks centralizados.
VITE_CRM_MOCKS=true

# URL pública da API backend consumida pelo navegador.
# Não armazene credenciais privadas em variáveis VITE_*.
VITE_API_BASE_URL=
